[user]
	name = Peter Peerdeman
	email = peter@peterpeerdeman.nl
	signingkey = 0x69359CCC90144354
[core]
	editor = nvim
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[rerere]
	enabled = true
[merge]
	tool = nvimdiff
[alias]
	ll = log --graph --date=relative --topo-order --pretty='format:%C(yellow)%h%C(yellow)%d %Cblue%ar %Cgreenby %an%Creset -- %s'
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = false
[include]
	# OS specifics (gpg, gh credentials, sourcetree) from the macos or linux package
	path = ~/.config/git/os
