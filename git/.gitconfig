[user]
	name = Peter Peerdeman
	email = peter@peterpeerdeman.nl
	signingkey = 0x69359CCC90144354
[core]
	editor = nvim
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[rerere]
	enabled = true
[merge]
	tool = nvimdiff
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[alias]
	ll = log --graph --date=relative --topo-order --pretty='format:%C(yellow)%h%C(yellow)%d %Cblue%ar %Cgreenby %an%Creset -- %s'
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = false
[gpg]
	program = /opt/homebrew/bin/gpg
# the empty helper resets inherited helpers so only gh is used
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
